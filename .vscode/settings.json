{
    "java.jdt.ls.java.home": "C:\\Program Files\\Android\\Android Studio\\jbr",
    "java.home": "C:\\Program Files\\Android\\Android Studio\\jbr",
    "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
    "python.analysis.extraPaths": [
        "${workspaceFolder}\\cit_department_system",
        "${workspaceFolder}\\.venv\\Lib\\site-packages"
    ],
    "python.autoComplete.extraPaths": [
        "${workspaceFolder}\\cit_department_system",
        "${workspaceFolder}\\.venv\\Lib\\site-packages"
    ],
    "python.analysis.typeCheckingMode": "off",
    "python.analysis.diagnosticSeverityOverrides": {
        "reportMissingImports": "none",
        "reportMissingModuleSource": "none"
    },
    "python.pyrefly.typeCheckingMode": "off",
    "python.pyrefly.disableTypeErrors": true,
    "python.pyrefly.configPath": "${workspaceFolder}\\pyrefly.toml",
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/CVS": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        ".venv": true,
        ".ruff_cache": true,
        "**/.pytest_cache": true,
        "**/__pycache__": true,
        "**/*.pyc": true,
        "**/.dart_tool": true
    },
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
        "README.md": "README*, DEPLOYMENT.md, LICENSE*",
        "index.php": "kiosk.php, cleanup.php, tap_attendance.php",
        "run_cit_system.bat": "pyrightconfig.json, pyrefly.toml"
    },
    "explorer.compactFolders": true
}
